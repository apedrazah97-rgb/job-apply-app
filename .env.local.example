# ── Opción A: Groq (para Vercel / compartir con amigos) ───────────────────────
# Gratis en console.groq.com — más rápido que Ollama local
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant   # default, cambia a llama-3.3-70b-versatile para mejor calidad

# ── Opción B: Ollama (para uso local, sin internet) ───────────────────────────
# Si GROQ_API_KEY no está definida, la app usa Ollama automáticamente
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
